# Public, read-only DreamDEX infrastructure. Defaults match the official SDK.
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
DREAMDEX_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
DREAMDEX_HTTP_RPC_URL=https://dream-rpc.somnia.network

# Verified on Shannon testnet on 2026-08-27. Override instead of editing code
# when DreamDEX rotates its venue.
DREAMDEX_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Set this to the trusted public deployment origin for canonical social cards.
NEXT_PUBLIC_SITE_URL=https://downrail.vercel.app

# Set true only for the Shannon deployment when a funded dedicated wallet is ready
# for the reviewed one-leg, <=10.00-unit pilot. Never reuse this flag for mainnet.
NEXT_PUBLIC_EXECUTION_ENABLED=false

# No private key belongs in this application.
